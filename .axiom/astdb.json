        },
        {
          "Enum": {
            "name": "TransferError",
            "variants": [
              {
                "name": "AccountNotFound",
                "fields": [
                  {
                    "name": "id",
                    "ty": "Int"
                  }
                ]
              },
              {
                "name": "InsufficientBalance",
                "fields": [
                  {
