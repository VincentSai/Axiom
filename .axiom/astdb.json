    "#fn_86b2caa2c2ff4cc1d3ffb3801cd8106f37c2e5f6142e770322cca3780c3d13a8": {
      "name": "execute_transfer",
      "params": [
        {
          "name": "from_id",
          "ty": "Int"
        },
        {
          "name": "to_id",
          "ty": "Int"
        },
        {
          "name": "amount",
          "ty": "Decimal"
        }
      ],
      "return_type": {
        "Custom": "Result<TransferReceipt, TransferError>"
      },
      "effects": [
        "Database",
        "Clock",
        "AuditLog"
      ],
      "requires": [
        {
          "BinaryOp": {
            "left": {
              "Ident": "amount"
            },
            "op": "GreaterThan",
            "right": {
              "Literal": {
                "Float": 0.0
              }
            }
          }
        },
        {
          "BinaryOp": {
            "left": {
              "Ident": "from_id"
            },
            "op": "NotEqual",
            "right": {
              "Ident": "to_id"
            }
          }
        }
      ],
      "ensures": [
        {
          "BinaryOp": {
            "left": {
              "BinaryOp": {
                "left": {
                  "Ident": "result"
                },
                "op": "Is",
                "right": {
                  "Ident": "Ok"
                }
              }
            },
            "op": "Implies",
            "right": {
              "Literal": {
                "Bool": true
              }
            }
          }
        }
      ],
      "body": {
        "Raw": "// 读取转出账户\r\n    let from_acc = match Database.find_account(from_id) {\r\n        Some(acc) => acc,\r\n        None => return Err(TransferError.AccountNotFound(from_id)),\r\n    };\r\n\r\n    // 读取转入账户\r\n    let to_acc = match Database.find_account(to_id) {\r\n        Some(acc) => acc,\r\n        None => return Err(TransferError.AccountNotFound(to_id)),\r\n    };\r\n\r\n    // 余额检查\r\n    if from_acc.balance < amount {\r\n        return Err(TransferError.InsufficientBalance(\r\n            required: amount, \r\n            available: from_acc.balance\r\n        ));\r\n    }\r\n\r\n    // 不可变更新 (纯数据变换)\r\n    let new_from = { ...from_acc, balance: from_acc.balance - amount };\r\n    let new_to = { ...to_acc, balance: to_acc.balance + amount };\r\n\r\n    // 提交副作用\r\n    Database.update_account(new_from);\r\n    Database.update_account(new_to);\r\n\r\n    let ts = Clock.now_timestamp();\r\n    AuditLog.info(\"Transfer completed successfully\");\r\n\r\n    Ok(TransferReceipt {\r\n        tx_id: \"TX_\" + ts.to_string(),\r\n        from_id: from_id,\r\n        to_id: to_id,\r\n        amount: amount,\r\n        timestamp: ts,\r\n    })"
      }
    },
