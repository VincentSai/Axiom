// =============================================================================
// Tier 2: Combat Pipeline and Status-Effect State Machine (Functions 091-140)
// Pure combat transformations layered on the Tier 1 stat/resistance subsystem.
// =============================================================================

// 091: Apply nonlinear armor mitigation, but preserve the one-damage hit floor.
fn resolve_physical_hit(atk: Int, def_val: Int) -> Int
    requires {
        atk >= 0,
        def_val >= 0,
    }
    ensures {
        result >= 1
    }
{
    let reduced = calc_armor_damage_reduction(atk, def_val);
    match reduced >= 1 {
        true => reduced,
        false => 1,
    }
}

// 092: Expand a critical hit by its percentage multiplier.
fn resolve_crit_hit(dmg: Int, is_crit: Bool, crit_pct: Int) -> Int
    requires {
        dmg >= 0,
        crit_pct >= 100,
    }
    ensures {
        result >= dmg
    }
{
    let normalized_dmg = calc_armor_damage_reduction(dmg, 0);
    match is_crit {
        true => normalized_dmg * crit_pct / 100,
        false => normalized_dmg,
    }
}

// 093: Return only the damage that penetrates the available shield pool.
fn apply_dual_shield_absorption(incoming_dmg: Int, shield_hp: Int) -> Int
    requires {
        incoming_dmg >= 0,
        shield_hp >= 0,
    }
    ensures {
        result >= 0,
        result <= incoming_dmg,
    }
{
    calc_effective_penetration(incoming_dmg, 0, shield_hp)
}

// 094: Each bleed stack deals five damage, doubled while the target is moving.
fn apply_bleed_stack_tick(stacks: Int, is_moving: Bool) -> Int
    requires {
        stacks >= 0
    }
    ensures {
        result >= 0
    }
{
    let base_tick = calc_lifesteal_conversion(stacks * 5, 100);
    match is_moving {
        true => base_tick * 2,
        false => base_tick,
    }
}

// 095: Apply the specification's duration-weighted eighty-percent poison decay.
fn apply_poison_exponential_decay(base_poison: Int, duration: Int) -> Int
    requires {
        base_poison >= 0,
        duration >= 0,
    }
    ensures {
        result >= 0
    }
{
    base_poison * (duration * 80 / 100)
}

// 096: Burn combines three percent of maximum HP with a flat true-damage term.
fn apply_burn_max_hp_tick(target_max_hp: Int, flat_burn: Int) -> Int
    requires {
        target_max_hp >= 0,
        flat_burn >= 0,
    }
    ensures {
        result >= flat_burn
    }
{
    target_max_hp * 3 / 100 + flat_burn
}

// 097: Five accumulated stacks transition the target into the frozen state.
fn check_freeze_threshold(freeze_stacks: Int) -> Bool
    requires {
        freeze_stacks >= 0
    }
    ensures {
        result == (freeze_stacks >= 5)
    }
{
    freeze_stacks >= 5
}

// 098: Stamina efficiency is a bounded percentage reduction of the base cost.
fn calc_stamina_skill_cost(base_cost: Int, stamina_eff: Int) -> Int
    requires {
        base_cost >= 0,
        stamina_eff >= 0,
        stamina_eff <= 100,
    }
    ensures {
        result >= 0,
        result <= base_cost,
    }
{
    base_cost * (100 - stamina_eff) / 100
}

// 099: Convert ten percent of missing mana into overload true damage.
fn calc_mana_overload_burst(missing_mana: Int) -> Int
    requires {
        missing_mana >= 0
    }
    ensures {
        result >= 0,
        result <= missing_mana,
    }
{
    missing_mana * 10 / 100
}

// 100: An impact equal to or greater than remaining poise causes a stun.
fn calc_poise_break_stun(poise: Int, impact: Int) -> Bool
    requires {
        poise >= 0,
        impact >= 0,
    }
    ensures {
        result == (impact >= poise)
    }
{
    impact >= poise
}

// Functions 101-140 form forty distinct Tier 2 pipeline stages. Each stage
// obtains its effective defense from the corresponding Tier 1 stat subsystem,
// then resolves penetration while maintaining the combat-wide one-damage floor.

fn combat_subsys_101(raw_dmg: Int, target_def: Int) -> Int
    requires { raw_dmg >= 0, target_def >= 0 }
    ensures { result >= 1 }
{
    let effective_def = stat_subsys_051(target_def, 0);
    match raw_dmg > effective_def { true => raw_dmg - effective_def, false => 1 }
}

