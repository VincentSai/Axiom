// =============================================================================
// Tier 3: Monster AI Decisions and Loot Economy (Functions 141-180)
// Pure AI/economy transformations layered on the Tier 2 combat subsystem.
// =============================================================================

// 141: Decay a precomputed threat value by Manhattan distance.
fn calc_threat_decay_by_dist(threat: Int, dist: Int) -> Int
    requires {
        threat >= 0,
        dist >= 0,
    }
    ensures {
        result >= 0,
        result <= threat,
    }
{
    threat * 100 / (100 + dist * 10)
}

// 142: Low health takes priority over aggro when selecting the AI state.
// State encoding: 1 = Flee, 2 = Chase, 3 = Patrol.
fn evaluate_ai_behavior_state(hp_pct: Int, aggro: Int) -> Int
    requires {
        hp_pct >= 0,
        hp_pct <= 100,
        aggro >= 0,
    }
    ensures {
        result >= 1,
        result <= 3,
    }
{
    // Integer division turns each threshold into a stable zero-or-one flag.
    let flee = 1 / (hp_pct / 20 + 1);
    let chase = 1 - 1 / (aggro / 51 + 1);
    flee + (1 - flee) * (3 - chase)
}

// 143: Resolve a 0-9999 roll against cumulative 60/25/10/4/1 weights.
fn calc_weighted_loot_tier(roll_val: Int) -> Int
    requires {
        roll_val >= 0,
        roll_val < 10000,
    }
    ensures {
        result >= 1,
        result <= 5,
    }
{
    // Each cumulative threshold contributes one tier once it is crossed.
    let crossed_tier_2 = 1 - 1 / (roll_val / 6000 + 1);
    let crossed_tier_3 = 1 - 1 / (roll_val / 8500 + 1);
    let crossed_tier_4 = 1 - 1 / (roll_val / 9500 + 1);
    let crossed_tier_5 = 1 - 1 / (roll_val / 9900 + 1);
    1 + crossed_tier_2 + crossed_tier_3 + crossed_tier_4 + crossed_tier_5
}

// 144: Add two roll points per luck point and clamp at 10000.
fn scale_drop_by_luck(roll_val: Int, luck: Int) -> Int
    requires {
        roll_val >= 0,
        roll_val <= 10000,
        luck >= 0,
        luck <= 5000,
    }
    ensures {
        result >= 0,
        result <= 10000,
    }
{
    let boosted_roll = roll_val + luck * 2;
    let crossed_cap = boosted_roll / 10001;
    boosted_roll - crossed_cap * (boosted_roll - 10000)
}

// 145: Penalize experience when the player substantially outlevels the monster.
fn calc_exp_gain_with_level_diff(base_exp: Int, player_lvl: Int, monster_lvl: Int) -> Int
    requires {
        base_exp >= 0,
        player_lvl >= 1,
        monster_lvl >= 1,
    }
    ensures {
        result >= 0,
        result <= base_exp,
    }
{
    let level_diff = player_lvl - monster_lvl;
    match level_diff > 10 {
        true => base_exp / 10,
        false => match level_diff > 5 {
            true => base_exp / 2,
            false => base_exp,
        },
    }
}

// 146: Quadratic experience curve from the benchmark specification.
fn calc_exp_to_next_level(level: Int) -> Int
    requires {
        level >= 0,
        level <= 300000000,
    }
    ensures {
        result >= 0,
        result == level * level * 100 + level * 500,
    }
{
    level * level * 100 + level * 500
}

// 147: Increase prices by two percent for every elapsed world day.
fn calc_shop_inflation_price(base_price: Int, world_day: Int) -> Int
    requires {
        base_price >= 0,
        world_day >= 0,
    }
    ensures {
        result >= base_price
    }
{
    base_price * (100 + world_day * 2) / 100
}

// Functions 148-180 are Tier 3 aggregation stages. Each stage delegates its
// delta calculation to a distinct Tier 2 combat stage, then adds the resulting
// nonnegative threat contribution to the current aggro value.

fn ai_loot_subsys_148(curr_aggro: Int, delta: Int) -> Int
    requires { curr_aggro >= 0, delta >= 0 }
    ensures { result >= curr_aggro }
{
    let threat = combat_subsys_101(delta, 0);
    curr_aggro + threat
}

fn ai_loot_subsys_149(curr_aggro: Int, delta: Int) -> Int
    requires { curr_aggro >= 0, delta >= 0 }
    ensures { result >= curr_aggro }
{
    let threat = combat_subsys_102(delta, 0);
    curr_aggro + threat
}

