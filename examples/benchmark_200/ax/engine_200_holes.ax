// =============================================================================
// Tier 3: Monster AI Decisions and Loot Economy (Functions 141-180)
// Pure AI/economy transformations layered on the Tier 2 combat subsystem.
// =============================================================================

// 141: Decay a precomputed threat value by Manhattan distance.
fn calc_threat_decay_by_dist(threat: Int, dist: Int) -> Int
    requires {
        threat >= 0,
        dist >= 0,
    }
    ensures {
        result >= 0,
        result <= threat,
    }
{
    ?hole
}

// 142: Low health takes priority over aggro when selecting the AI state.
// State encoding: 1 = Flee, 2 = Chase, 3 = Patrol.
fn evaluate_ai_behavior_state(hp_pct: Int, aggro: Int) -> Int
    requires {
        hp_pct >= 0,
        hp_pct <= 100,
        aggro >= 0,
    }
    ensures {
        result >= 1,
        result <= 3,
    }
{
    ?hole
}

// 143: Resolve a 0-9999 roll against cumulative 60/25/10/4/1 weights.
fn calc_weighted_loot_tier(roll_val: Int) -> Int
    requires {
        roll_val >= 0,
        roll_val < 10000,
    }
    ensures {
        result >= 1,
        result <= 5,
    }
{
    ?hole
}

// 144: Add two roll points per luck point and clamp at 10000.
fn scale_drop_by_luck(roll_val: Int, luck: Int) -> Int
    requires {
        roll_val >= 0,
        roll_val <= 10000,
        luck >= 0,
        luck <= 5000,
    }
    ensures {
        result >= 0,
        result <= 10000,
    }
{
    ?hole
}

// 145: Penalize experience when the player substantially outlevels the monster.
fn calc_exp_gain_with_level_diff(base_exp: Int, player_lvl: Int, monster_lvl: Int) -> Int
    requires {
        base_exp >= 0,
        player_lvl >= 1,
        monster_lvl >= 1,
    }
    ensures {
        result >= 0,
        result <= base_exp,
    }
{
    ?hole
}

// 146: Quadratic experience curve from the benchmark specification.
fn calc_exp_to_next_level(level: Int) -> Int
    requires {
        level >= 0,
        level <= 300000000,
    }
    ensures {
        result >= 0,
        result == level * level * 100 + level * 500,
    }
{
    ?hole
}

// 147: Increase prices by two percent for every elapsed world day.
fn calc_shop_inflation_price(base_price: Int, world_day: Int) -> Int
    requires {
        base_price >= 0,
        world_day >= 0,
    }
    ensures {
        result >= base_price
    }
{
    ?hole
}

