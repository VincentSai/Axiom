// Shared benchmark domain model from SPEC_200.md.

type Point = {
    x: Int,
    y: Int,
}

type Velocity = {
    dx: Int,
    dy: Int,
}

type Rect = {
    min_x: Int,
    min_y: Int,
    max_x: Int,
    max_y: Int,
}

type BaseAttributes = {
    strength: Int,
    agility: Int,
    intelligence: Int,
    vitality: Int,
}

type DerivedStats = {
    max_hp: Int,
    max_mana: Int,
    max_stamina: Int,
    phys_atk: Int,
    magic_atk: Int,
    armor: Int,
    magic_res: Int,
    crit_rate: Int,
    crit_dmg_pct: Int,
    dodge_rate: Int,
    move_speed: Int,
}

type StatusEffect = {
    bleed_stacks: Int,
    poison_duration: Int,
    burn_damage: Int,
    freeze_stacks: Int,
    shield_hp: Int,
}

type Entity = {
    id: Int,
    pos: Point,
    base_attr: BaseAttributes,
    stats: DerivedStats,
    status: StatusEffect,
    curr_hp: Int,
    curr_mana: Int,
    curr_stamina: Int,
    gold: Int,
    level: Int,
    exp: Int,
    weight: Int,
    max_weight: Int,
    is_alive: Bool,
}

// Tier 0: spatial geometry and grid math (functions 001-040).
// All functions are total over their declared preconditions and are pure.

// 001 - Manhattan grid distance.
fn calc_manhattan_dist(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 002 - Chebyshev (king-move) distance.
fn calc_chebyshev_dist(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 003 - Squared Euclidean distance.
fn calc_euclidean_sq(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 004 - Circular range test using squared values.
fn check_in_radius_sq(dist_sq: Int, radius: Int) -> Bool
    requires { dist_sq >= 0, radius >= 0 }
    ensures { result == (dist_sq <= radius * radius) }
{
    ?hole
}

// 005 - Bresenham horizontal sign step.
fn bresenham_step_x(x1: Int, x2: Int) -> Int
    requires { true }
    ensures { result >= -1, result <= 1 }
{
    ?hole
}

// 006 - Bresenham vertical sign step.
fn bresenham_step_y(y1: Int, y2: Int) -> Int
    requires { true }
    ensures { result >= -1, result <= 1 }
{
    ?hole
}

// 007 - Pack X with the low 16 bits of Y using arithmetic equivalents.
fn pack_coords_to_hash(x: Int, y: Int) -> Int
    requires { x >= 0, y >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 008 - Unpack the high-coordinate component.
fn unpack_hash_x(hash: Int) -> Int
    requires { hash >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 009 - Unpack the low 16-bit coordinate component.
fn unpack_hash_y(hash: Int) -> Int
    requires { hash >= 0 }
    ensures { result >= 0, result < 65536 }
{
    ?hole
}

// 010 - Positive modulo for a wrapping X coordinate.
fn wrap_map_coord_x(x: Int, width: Int) -> Int
    requires { width > 0 }
    ensures { result >= 0, result < width }
{
    ?hole
}

// 011 - Positive modulo for a wrapping Y coordinate.
fn wrap_map_coord_y(y: Int, height: Int) -> Int
    requires { height > 0 }
    ensures { result >= 0, result < height }
{
    ?hole
}

// 012 - Clamp X into [0, width - 1].
fn clamp_to_bounds_x(x: Int, width: Int) -> Int
    requires { width > 0 }
    ensures { result >= 0, result < width }
{
    ?hole
}

// 013 - Clamp Y into [0, height - 1].
fn clamp_to_bounds_y(y: Int, height: Int) -> Int
    requires { height > 0 }
    ensures { result >= 0, result < height }
{
    ?hole
}

// 014 - Inclusive axis-aligned bounding-box intersection.
fn check_aabb_overlap(
    min_x1: Int,
    min_y1: Int,
    max_x1: Int,
    max_y1: Int,
    min_x2: Int,
    min_y2: Int,
    max_x2: Int,
    max_y2: Int
) -> Bool
    requires {
        min_x1 <= max_x1,
        min_y1 <= max_y1,
        min_x2 <= max_x2,
        min_y2 <= max_y2,
    }
    ensures {
        result == (max_x1 >= min_x2 && min_x1 <= max_x2 && max_y1 >= min_y2 && min_y1 <= max_y2)
    }
{
    ?hole
}

// 015 - Flatten a two-dimensional grid coordinate.
fn calc_grid_index(x: Int, y: Int, map_width: Int) -> Int
    requires { x >= 0, y >= 0, map_width > 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 016 - Terrain-weighted line-of-sight energy cost.
fn calc_line_of_sight_cost(dist: Int, terrain_density: Int) -> Int
    requires { dist >= 0, terrain_density >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 017 - Cartesian quadrant code: NE=0, NW=1, SW=2, SE=3.
fn spatial_subsys_017(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0, result <= 3 }
{
    ?hole
}

// 018 - Diamond-field mask distance from the origin.
fn spatial_subsys_018(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 019 - Farthest nonnegative ray-intersection depth.
fn spatial_subsys_019(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= a, result >= b }
{
    ?hole
}

// 020 - Quadtree child-cell index.
fn spatial_subsys_020(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0, b < 4 }
    ensures { result >= a * 4, result < (a + 1) * 4 }
{
    ?hole
}

// 021 - Squared displacement of a grid vector.
fn spatial_subsys_021(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 022 - Nonnegative projection-scale product.
fn spatial_subsys_022(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 023 - Smaller nonnegative axis extent.
fn spatial_subsys_023(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0, result <= a, result <= b }
{
    ?hole
}

// 024 - Sum of normalized axis directions.
fn spatial_subsys_024(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= -2, result <= 2 }
{
    ?hole
}

// 025 - Inclusive-axis span delta.
fn spatial_subsys_025(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 026 - Midpoint of an ordered nonnegative interval.
fn spatial_subsys_026(a: Int, b: Int) -> Int
    requires { a >= 0, a <= b }
    ensures { result >= a, result <= b }
{
    ?hole
}

// 027 - Pack a bounded cell-local coordinate.
fn spatial_subsys_027(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0, b < 65536 }
    ensures { result >= 0 }
{
    ?hole
}

// 028 - Manhattan ring number for an offset.
fn spatial_subsys_028(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 029 - Area of a nonnegative grid rectangle.
fn spatial_subsys_029(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 030 - Squared diagonal length of a grid cell.
fn spatial_subsys_030(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0 }
{
    ?hole
}

// 031 - Advance a ray by a nonnegative origin and step.
fn spatial_subsys_031(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= a, result >= b }
{
    ?hole
}

// 032 - Remaining visibility after nonnegative occlusion.
fn spatial_subsys_032(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0, result <= a }
{
    ?hole
}

// 033 - Shared length of two origin-aligned intervals.
fn spatial_subsys_033(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0, result <= a, result <= b }
{
    ?hole
}

// 034 - Grid bucket containing coordinate a at resolution b.
fn spatial_subsys_034(a: Int, b: Int) -> Int
    requires { a >= 0, b > 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 035 - Nonnegative cell-local coordinate modulo b.
fn spatial_subsys_035(a: Int, b: Int) -> Int
    requires { a >= 0, b > 0 }
    ensures { result >= 0, result < b }
{
    ?hole
}

// 036 - Binary half-plane/sector selector.
fn spatial_subsys_036(a: Int, b: Int) -> Int
    requires { true }
    ensures { result >= 0, result <= 1 }
{
    ?hole
}

// 037 - Width of a row in a radius-a diamond at offset b.
fn spatial_subsys_037(a: Int, b: Int) -> Int
    requires { a >= 0, b >= -a, b <= a }
    ensures { result > 0 }
{
    ?hole
}

// 038 - Start offset for quadtree range a with stride b + 1.
fn spatial_subsys_038(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

// 039 - Collision penetration bounded by both axis depths.
fn spatial_subsys_039(a: Int, b: Int) -> Int
    requires { a >= 0, b >= 0 }
    ensures { result >= 0, result <= a, result <= b }
{
    ?hole
}

// 040 - Bresenham-style doubled raster error update.
fn spatial_subsys_040(a: Int, b: Int) -> Int
    requires { true }
    ensures { result == 2 * a - b }
{
    ?hole
}

// Tier 1: RPG stat mapping and non-linear resistance calculations.
// Element ids used by calc_elemental_multiplier:
//   0 = fire, 1 = wind, 2 = earth, 3 = lightning, 4 = water.

fn calc_max_hp_from_vit(base_hp: Int, vitality: Int, strength: Int) -> Int
    requires { base_hp >= 0, vitality >= 0, strength >= 0 }
    ensures { result >= base_hp }
{
    ?hole
}

fn calc_max_mana_from_int(base_mana: Int, intelligence: Int) -> Int
    requires { base_mana >= 0, intelligence >= 0 }
    ensures { result >= base_mana }
{
    ?hole
}

fn calc_phys_atk_from_str(strength: Int, agility: Int) -> Int
    requires { strength >= 0, agility >= 0 }
    ensures { result >= 0 }
{
    ?hole
}

fn calc_armor_damage_reduction(damage: Int, armor: Int) -> Int
    requires { damage >= 0, armor >= 0 }
    ensures { result >= 0, result <= damage }
{
    ?hole
}

fn calc_magic_res_reduction(magic_dmg: Int, res: Int) -> Int
    requires { magic_dmg >= 0, res >= 0 }
    ensures { result >= 0, result <= magic_dmg }
{
    ?hole
}

fn calc_elemental_multiplier(elem_type: Int, target_type: Int, base_dmg: Int) -> Int
    requires {
        elem_type >= 0,
        elem_type <= 4,
        target_type >= 0,
        target_type <= 4,
        base_dmg >= 0
    }
    ensures { result >= 0, result <= base_dmg * 150 / 100 }
{
    ?hole
}

fn calc_crit_chance_clamped(base_crit: Int, agility: Int) -> Int
    requires { agility >= 0 }
    ensures { result >= 0, result <= 10000 }
{
    ?hole
}

fn calc_effective_penetration(raw_armor: Int, pct_pen: Int, flat_pen: Int) -> Int
    requires {
        raw_armor >= 0,
        pct_pen >= 0,
        pct_pen <= 100,
        flat_pen >= 0
    }
    ensures { result >= 0, result <= raw_armor }
{
    ?hole
}

fn calc_overburden_penalty(weight: Int, max_weight: Int, base_speed: Int) -> Int
    requires { weight >= 0, max_weight > 0, base_speed >= 0 }
    ensures { result >= 0, result <= base_speed }
{
    ?hole
}

fn calc_lifesteal_conversion(damage_dealt: Int, lifesteal_rate: Int) -> Int
    requires {
        damage_dealt >= 0,
        lifesteal_rate >= 0,
        lifesteal_rate <= 100
    }
    ensures { result >= 0, result <= damage_dealt }
{
    ?hole
}

