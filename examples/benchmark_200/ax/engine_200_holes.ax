// Axiom Pipeline Stage 1: Architect skeleton for the 200-function RPG benchmark.
// Reference: examples/benchmark_200/SPEC_200.md

type Point = {
    x: Int,
    y: Int,
}

type Velocity = {
    dx: Int,
    dy: Int,
}

type Rect = {
    min_x: Int,
    min_y: Int,
    max_x: Int,
    max_y: Int,
}

type BaseAttributes = {
    strength: Int,
    agility: Int,
    intelligence: Int,
    vitality: Int,
}

type DerivedStats = {
    max_hp: Int,
    max_mana: Int,
    max_stamina: Int,
    phys_atk: Int,
    magic_atk: Int,
    armor: Int,
    magic_res: Int,
    crit_rate: Int,
    crit_dmg_pct: Int,
    dodge_rate: Int,
    move_speed: Int,
}

type StatusEffect = {
    bleed_stacks: Int,
    poison_duration: Int,
    burn_damage: Int,
    freeze_stacks: Int,
    shield_hp: Int,
}

type Entity = {
    id: Int,
    pos: Point,
    base_attr: BaseAttributes,
    stats: DerivedStats,
    status: StatusEffect,
    curr_hp: Int,
    curr_mana: Int,
    curr_stamina: Int,
    gold: Int,
    level: Int,
    exp: Int,
    weight: Int,
    max_weight: Int,
    is_alive: Bool,
}

// Tier 0 (001-040): spatial geometry and grid math

fn calc_manhattan_dist(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires {
        x1 >= -1000000,
        x1 <= 1000000,
        y1 >= -1000000,
        y1 <= 1000000,
        x2 >= -1000000,
        x2 <= 1000000,
        y2 >= -1000000,
        y2 <= 1000000,
    }
    ensures {
        result >= 0,
        result == 0 => x1 == x2 && y1 == y2,
    }
{
    ?hole
}

fn calc_chebyshev_dist(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires {
        x1 >= -1000000,
        x1 <= 1000000,
        y1 >= -1000000,
        y1 <= 1000000,
        x2 >= -1000000,
        x2 <= 1000000,
        y2 >= -1000000,
        y2 <= 1000000,
    }
    ensures {
        result >= 0,
        result == 0 => x1 == x2 && y1 == y2,
    }
{
    ?hole
}

fn calc_euclidean_sq(x1: Int, y1: Int, x2: Int, y2: Int) -> Int
    requires {
        x1 >= -1000000,
        x1 <= 1000000,
        y1 >= -1000000,
        y1 <= 1000000,
        x2 >= -1000000,
        x2 <= 1000000,
        y2 >= -1000000,
        y2 <= 1000000,
    }
    ensures {
        result >= 0,
        result == 0 => x1 == x2 && y1 == y2,
    }
{
    ?hole
}

fn check_in_radius_sq(dist_sq: Int, radius: Int) -> Bool
    requires {
        dist_sq >= 0,
        dist_sq <= 1000000000000,
        radius >= 0,
        radius <= 1000000,
    }
    ensures {
        result == (dist_sq <= radius * radius),
    }
{
    ?hole
}

fn bresenham_step_x(x1: Int, x2: Int) -> Int
    requires {
        x1 >= -1000000,
        x1 <= 1000000,
        x2 >= -1000000,
        x2 <= 1000000,
    }
    ensures {
        result >= -1,
        result <= 1,
        x2 > x1 => result == 1,
        x2 < x1 => result == -1,
        x2 == x1 => result == 0,
    }
{
    ?hole
}

fn bresenham_step_y(y1: Int, y2: Int) -> Int
    requires {
        y1 >= -1000000,
        y1 <= 1000000,
        y2 >= -1000000,
        y2 <= 1000000,
    }
    ensures {
        result >= -1,
        result <= 1,
        y2 > y1 => result == 1,
        y2 < y1 => result == -1,
        y2 == y1 => result == 0,
    }
{
    ?hole
}

fn pack_coords_to_hash(x: Int, y: Int) -> Int
    requires {
        x >= 0,
        x <= 65535,
        y >= 0,
        y <= 65535,
    }
    ensures {
        result >= 0,
        result <= 4294967295,
    }
{
    ?hole
}

fn unpack_hash_x(hash: Int) -> Int
    requires {
        hash >= 0,
        hash <= 4294967295,
    }
    ensures {
        result >= 0,
        result <= 65535,
    }
{
    ?hole
}

fn unpack_hash_y(hash: Int) -> Int
    requires {
        hash >= 0,
        hash <= 4294967295,
    }
    ensures {
        result >= 0,
        result < 65536,
    }
{
    ?hole
}

fn wrap_map_coord_x(x: Int, width: Int) -> Int
    requires {
        x >= -1000000,
        x <= 1000000,
        width > 0,
        width <= 1000000,
    }
    ensures {
        result >= 0,
        result < width,
    }
{
    ?hole
}

fn wrap_map_coord_y(y: Int, height: Int) -> Int
    requires {
        y >= -1000000,
        y <= 1000000,
        height > 0,
        height <= 1000000,
    }
    ensures {
        result >= 0,
        result < height,
    }
{
    ?hole
}

fn clamp_to_bounds_x(x: Int, width: Int) -> Int
    requires {
        x >= -1000000,
        x <= 1000000,
        width > 0,
        width <= 1000000,
    }
    ensures {
        result >= 0,
        result < width,
        x >= 0 && x < width => result == x,
    }
{
    ?hole
}

fn clamp_to_bounds_y(y: Int, height: Int) -> Int
    requires {
        y >= -1000000,
        y <= 1000000,
        height > 0,
        height <= 1000000,
    }
    ensures {
        result >= 0,
        result < height,
        y >= 0 && y < height => result == y,
    }
{
    ?hole
}

fn check_aabb_overlap(min_x1: Int, min_y1: Int, max_x1: Int, max_y1: Int, min_x2: Int, min_y2: Int, max_x2: Int, max_y2: Int) -> Bool
    requires {
        min_x1 <= max_x1,
        min_y1 <= max_y1,
        min_x2 <= max_x2,
        min_y2 <= max_y2,
        min_x1 >= -1000000,
        max_x1 <= 1000000,
        min_y1 >= -1000000,
        max_y1 <= 1000000,
        min_x2 >= -1000000,
        max_x2 <= 1000000,
        min_y2 >= -1000000,
        max_y2 <= 1000000,
    }
    ensures {
        result == (max_x1 >= min_x2 && min_x1 <= max_x2 && max_y1 >= min_y2 && min_y1 <= max_y2),
    }
{
    ?hole
}

fn calc_grid_index(x: Int, y: Int, map_width: Int) -> Int
    requires {
        x >= 0,
        y >= 0,
        map_width > 0,
        x < map_width,
        y <= 1000000,
        map_width <= 1000000,
    }
    ensures {
        result == y * map_width + x,
        result >= 0,
    }
{
    ?hole
}

fn calc_line_of_sight_cost(dist: Int, terrain_density: Int) -> Int
    requires {
        dist >= 0,
        dist <= 1000000,
        terrain_density >= 0,
        terrain_density <= 1000000,
    }
    ensures {
        result == dist * terrain_density / 100,
        result >= 0,
    }
{
    ?hole
}

