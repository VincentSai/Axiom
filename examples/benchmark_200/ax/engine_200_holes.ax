}

fn apply_bleed_stack_tick(stacks: Int, is_moving: Bool) -> Int
    requires {
        stacks >= 0,
        stacks <= 1000000,
    }
    ensures {
        result >= 0,
        is_moving == true => result == stacks * 10,
        is_moving == false => result == stacks * 5,
    }
{
    ?hole
}

fn apply_poison_exponential_decay(base_poison: Int, duration: Int) -> Int
    requires {
