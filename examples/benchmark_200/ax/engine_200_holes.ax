fn apply_burn_max_hp_tick(target_max_hp: Int, flat_burn: Int) -> Int
    requires {
        target_max_hp >= 0,
        target_max_hp <= 1000000,
        flat_burn >= 0,
        flat_burn <= 1000000,
    }
    ensures {
        result >= flat_burn,
        result == target_max_hp * 3 / 100 + flat_burn,
