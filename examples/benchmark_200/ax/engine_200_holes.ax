// Tier 2 (091-140): combat flow and status state machines

fn resolve_physical_hit(atk: Int, def_val: Int) -> Int
    requires {
        atk >= 0,
        atk <= 1000000,
        def_val >= 0,
        def_val <= 1000000,
    }
    ensures {
        result >= 1,
        result <= atk + 1,
    }
{
    ?hole
}

fn resolve_crit_hit(dmg: Int, is_crit: Bool, crit_pct: Int) -> Int
    requires {
        dmg >= 0,
        dmg <= 1000000,
        crit_pct >= 100,
        crit_pct <= 1000,
    }
    ensures {
        result >= 0,
        is_crit == false => result == dmg,
        is_crit == true => result >= dmg,
    }
{
    ?hole
}

fn apply_dual_shield_absorption(incoming_dmg: Int, shield_hp: Int) -> Int
    requires {
        incoming_dmg >= 0,
        incoming_dmg <= 1000000,
        shield_hp >= 0,
        shield_hp <= 1000000,
    }
    ensures {
        result >= 0,
        result <= incoming_dmg,
    }
{
