// 193: Schedule initiative using elapsed cycles as agility and turn modulo 20.
fn world_engine_193(turn_num: Int, cycle_len: Int) -> Int
    requires { turn_num >= 0, cycle_len > 0 }
    ensures { result >= 0 }
{
    ?hole
