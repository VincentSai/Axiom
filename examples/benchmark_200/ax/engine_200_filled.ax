fn combat_func_091(raw_dmg: Int, target_def: Int) -> Int
    requires { raw_dmg >= 0, target_def >= 0 }
    ensures { result >= 1 }
{
    let eff_def = stat_func_042(target_def, 0);
    if raw_dmg > eff_def { raw_dmg - eff_def } else { 1 }
}

