// ==========================================================================
// Axiom Ultra-Scale Game Engine Benchmark (200 Functions with 5-Tier Topology)
// ==========================================================================

type Point = {
    x: Int,
    y: Int,
}

type Stats = {
    hp: Int,
    max_hp: Int,
    atk: Int,
    def: Int,
    mana: Int,
    max_mana: Int,
    stamina: Int,
    max_stamina: Int,
}

type Entity = {
    id: Int,
    pos: Point,
    stats: Stats,
    level: Int,
    exp: Int,
    gold: Int,
    is_alive: Bool,
}

effect AudioEffect {
    fn play_sfx(id: Int) -> ();
}

effect LogEffect {
    fn log_info(code: Int) -> ();
}

