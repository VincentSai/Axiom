fn engine_func_181(turn_num: Int, cycle_len: Int) -> Int
    requires { turn_num >= 0, cycle_len > 0 }
    ensures { result >= 0 && result < cycle_len }
{
    let _w = world_func_142(turn_num, 0);
    turn_num - (turn_num / cycle_len * cycle_len)
}

