// Deterministic, side-effect-free gameplay core for a survivor-style game.
// All state transitions are explicit: no clock, random source, renderer, or
// other effect participates in these calculations.

type Vec2 = {
    x: Float,
    y: Float,
}

type Player = {
    pos: Vec2,
    hp: Int,
    max_hp: Int,
    exp: Int,
    level: Int,
    speed: Float,
}

type Monster = {
    id: Int,
    pos: Vec2,
    hp: Int,
    speed: Float,
    kind: Int,
}

type Projectile = {
    pos: Vec2,
    vel: Vec2,
    damage: Int,
    pierce: Int,
    lifetime: Float,
}

type Gem = {
    pos: Vec2,
    exp_val: Int,
}

type GameState = {
    player: Player,
    score: Int,
    is_game_over: Bool,
}

type PlayerInput = {
    move_x: Float,
    move_y: Float,
    is_firing: Bool,
}

// The Unity bridge consumes these wire records directly. Their fields stay
// scalar so the generated Rust and C# layouts are deterministic across FFI.
type EntityKind = | Player | Monster | Projectile | Gem

type VisualEventKind = | Spawn | Despawn | Hit | Death | Shot | Pickup | LevelUp | GameOver

type EntitySnapshot = {
    id: Int,
    kind: EntityKind,
    x: Float,
    y: Float,
    hp: Int,
    max_hp: Int,
    exp: Int,
    level: Int,
    score: Int,
    sprite_id: Int,
    active: Bool,
}

type VisualEvent = {
    kind: VisualEventKind,
    entity_id: Int,
    asset_id: Int,
    x: Float,
    y: Float,
    value: Int,
}

// Squared distance avoids a square root and is sufficient for collision tests.
fn distance_sq(p1: Vec2, p2: Vec2) -> Float
    requires {
        p1.x >= -1000000.0,
        p1.x <= 1000000.0,
        p1.y >= -1000000.0,
        p1.y <= 1000000.0,
        p2.x >= -1000000.0,
        p2.x <= 1000000.0,
        p2.y >= -1000000.0,
        p2.y <= 1000000.0,
    }
    ensures {
        result >= 0.0,
        result == (p1.x - p2.x) * (p1.x - p2.x) + (p1.y - p2.y) * (p1.y - p2.y),
    }
{
    let dx = p1.x - p2.x;
    let dy = p1.y - p2.y;
    dx * dx + dy * dy
}

// Two circles touch or overlap when their squared center distance is no larger
// than the square of their combined radius.
fn check_collision(p1: Vec2, r1: Float, p2: Vec2, r2: Float) -> Bool
    requires {
        r1 >= 0.0,
        r1 <= 1000000.0,
        r2 >= 0.0,
        r2 <= 1000000.0,
        p1.x >= -1000000.0,
        p1.x <= 1000000.0,
        p1.y >= -1000000.0,
        p1.y <= 1000000.0,
        p2.x >= -1000000.0,
        p2.x <= 1000000.0,
        p2.y >= -1000000.0,
        p2.y <= 1000000.0,
    }
    ensures {
        result == (distance_sq(p1, p2) <= (r1 + r2) * (r1 + r2)),
    }
{
    distance_sq(p1, p2) <= (r1 + r2) * (r1 + r2)
}

// This scalar helper makes the bounded addition contract independently
// verifiable before clamp_hp performs its piecewise selection.
fn hp_after_delta_unclamped(current: Int, delta: Int) -> Int
    requires {
        current >= -1000000000,
        current <= 1000000000,
        delta >= -1000000000,
        delta <= 1000000000,
    }
    ensures {
        result == current + delta,
        result >= -2000000000,
        result <= 2000000000,
    }
{
    current + delta
}

// Apply a signed HP delta and clamp the result to the closed interval
// [0, max_hp].
fn clamp_hp(current: Int, delta: Int, max_hp: Int) -> Int
    requires {
        current >= -1000000000,
        current <= 1000000000,
        delta >= -1000000000,
        delta <= 1000000000,
        max_hp >= 0,
        max_hp <= 1000000000,
    }
    ensures {
        result >= 0,
        result <= max_hp,
        current + delta < 0 || current + delta > max_hp || result == current + delta,
        current + delta >= 0 || result == 0,
        current + delta <= max_hp || result == max_hp,
    }
{
    let candidate = hp_after_delta_unclamped(current, delta);
    match candidate < 0 {
        true => 0,
        false => match candidate > max_hp {
            true => max_hp,
            false => candidate,
        },
    }
}

// Armor subtracts damage point-for-point. A positive hit always deals at least
// one point; a zero-damage hit remains zero.
fn calc_damage_reduction(armor: Int, raw_damage: Int) -> Int
    requires {
        armor >= 0,
        armor <= 1000000000,
        raw_damage >= 0,
        raw_damage <= 1000000000,
    }
    ensures {
        result >= 0,
        result <= raw_damage,
        raw_damage != 0 || result == 0,
        raw_damage == 0 || result >= 1,
        armor != 0 || result == raw_damage,
    }
{
    let reduced = clamp_hp(raw_damage, -armor, raw_damage);
    match raw_damage == 0 {
        true => 0,
        false => match reduced == 0 {
            true => 1,
            false => reduced,
        },
    }
}

// Direction is intentionally not normalized here. The caller supplies an axis
// vector, and this function applies the exact deterministic Euler displacement.
fn move_position(pos: Vec2, dir_x: Float, dir_y: Float, speed: Float, dt: Float) -> Vec2
    requires {
        pos.x >= -1000000.0,
        pos.x <= 1000000.0,
        pos.y >= -1000000.0,
        pos.y <= 1000000.0,
        dir_x >= -1.0,
        dir_x <= 1.0,
        dir_y >= -1.0,
        dir_y <= 1.0,
        speed >= 0.0,
        speed <= 1000000.0,
        dt >= 0.0,
        dt <= 1000.0,
    }
    ensures {
        result.x == pos.x + dir_x * speed * dt,
        result.y == pos.y + dir_y * speed * dt,
    }
{
    Vec2 {
        x: pos.x + dir_x * speed * dt,
        y: pos.y + dir_y * speed * dt,
    }
}

// Linear progression: reaching level N requires 100 * N experience points.
fn exp_for_next_level(current_level: Int) -> Int
    requires {
        current_level >= 1,
        current_level <= 10000000,
    }
    ensures {
        result == current_level * 100,
        result >= 100,
        result <= 1000000000,
    }
{
    current_level * 100
}

fn can_level_up(current_exp: Int, level: Int) -> Bool
    requires {
        current_exp >= 0,
        current_exp <= 1000000000,
        level >= 1,
        level <= 10000000,
    }
    ensures {
        result == (current_exp >= level * 100),
    }
{
    current_exp >= level * 100
}

// Advance only the player's position. Combat, experience, and firing systems
// consume the same input elsewhere; this movement step preserves every other
// Player field.
fn step_player(player: Player, input: PlayerInput, dt: Float) -> Player
    requires {
        player.pos.x >= -1000000.0,
        player.pos.x <= 1000000.0,
        player.pos.y >= -1000000.0,
        player.pos.y <= 1000000.0,
        player.hp >= 0,
        player.hp <= player.max_hp,
        player.max_hp >= 0,
        player.exp >= 0,
        player.level >= 1,
        player.speed >= 0.0,
        player.speed <= 1000000.0,
        input.move_x >= -1.0,
        input.move_x <= 1.0,
        input.move_y >= -1.0,
        input.move_y <= 1.0,
        dt >= 0.0,
        dt <= 1000.0,
    }
    ensures {
        result.pos.x == player.pos.x + input.move_x * player.speed * dt,
        result.pos.y == player.pos.y + input.move_y * player.speed * dt,
        result.hp == player.hp,
        result.max_hp == player.max_hp,
        result.exp == player.exp,
        result.level == player.level,
        result.speed == player.speed,
    }
{
    let new_pos = move_position(player.pos, input.move_x, input.move_y, player.speed, dt);
    Player {
        pos: new_pos,
        hp: player.hp,
        max_hp: player.max_hp,
        exp: player.exp,
        level: player.level,
        speed: player.speed,
    }
}

// Step projectile position along its velocity vector and decrement its lifetime.
fn step_projectile(proj: Projectile, dt: Float) -> Projectile
    requires {
        proj.pos.x >= -1000000.0,
        proj.pos.x <= 1000000.0,
        proj.pos.y >= -1000000.0,
        proj.pos.y <= 1000000.0,
        proj.vel.x >= -1000000.0,
        proj.vel.x <= 1000000.0,
        proj.vel.y >= -1000000.0,
        proj.vel.y <= 1000000.0,
        proj.damage >= 0,
        proj.damage <= 1000000000,
        proj.pierce >= 0,
        proj.pierce <= 1000000000,
        proj.lifetime >= -1000.0,
        proj.lifetime <= 1000.0,
        dt >= 0.0,
        dt <= 1000.0,
    }
    ensures {
        result.pos.x == proj.pos.x + proj.vel.x * dt,
        result.pos.y == proj.pos.y + proj.vel.y * dt,
        result.damage == proj.damage,
        result.pierce == proj.pierce,
        result.lifetime == proj.lifetime - dt,
    }
{
    Projectile {
        pos: Vec2 {
            x: proj.pos.x + proj.vel.x * dt,
            y: proj.pos.y + proj.vel.y * dt,
        },
        vel: proj.vel,
        damage: proj.damage,
        pierce: proj.pierce,
        lifetime: proj.lifetime - dt,
    }
}

fn is_projectile_alive(proj: Projectile) -> Bool
    requires {
        proj.lifetime >= -1000000.0,
        proj.lifetime <= 1000000.0,
    }
    ensures {
        result == (proj.lifetime > 0.0),
    }
{
    proj.lifetime > 0.0
}

// Apply damage to a monster with armor reduction, returning the updated monster.
fn apply_damage_to_monster(monster: Monster, raw_damage: Int, armor: Int) -> Monster
    requires {
        monster.hp >= 0,
        monster.hp <= 1000000000,
        monster.pos.x >= -1000000.0,
        monster.pos.x <= 1000000.0,
        monster.pos.y >= -1000000.0,
        monster.pos.y <= 1000000.0,
        monster.speed >= 0.0,
        monster.speed <= 1000000.0,
        raw_damage >= 0,
        raw_damage <= 1000000000,
        armor >= 0,
        armor <= 1000000000,
    }
    ensures {
        result.id == monster.id,
        result.pos.x == monster.pos.x,
        result.pos.y == monster.pos.y,
        result.speed == monster.speed,
        result.kind == monster.kind,
        result.hp <= monster.hp,
        result.hp >= 0,
    }
{
    let eff_damage = calc_damage_reduction(armor, raw_damage);
    let new_hp = clamp_hp(monster.hp, -eff_damage, monster.hp);
    Monster {
        id: monster.id,
        pos: monster.pos,
        hp: new_hp,
        speed: monster.speed,
        kind: monster.kind,
    }
}

// Apply damage to the player, respecting HP bounds and level/speed persistence.
fn apply_damage_to_player(player: Player, raw_damage: Int) -> Player
    requires {
        player.pos.x >= -1000000.0,
        player.pos.x <= 1000000.0,
        player.pos.y >= -1000000.0,
        player.pos.y <= 1000000.0,
        player.hp >= 0,
        player.hp <= player.max_hp,
        player.max_hp >= 0,
        player.max_hp <= 1000000000,
        player.exp >= 0,
        player.level >= 1,
        player.speed >= 0.0,
        player.speed <= 1000000.0,
        raw_damage >= 0,
        raw_damage <= 1000000000,
    }
    ensures {
        result.pos.x == player.pos.x,
        result.pos.y == player.pos.y,
        result.max_hp == player.max_hp,
        result.exp == player.exp,
        result.level == player.level,
        result.speed == player.speed,
        result.hp >= 0,
        result.hp <= player.max_hp,
    }
{
    let new_hp = clamp_hp(player.hp, -raw_damage, player.max_hp);
    Player {
        pos: player.pos,
        hp: new_hp,
        max_hp: player.max_hp,
        exp: player.exp,
        level: player.level,
        speed: player.speed,
    }
}

// Apply experience from a collected gem. If experience reaches the threshold,
// level up the player, increase max HP by 20, and fully restore HP.
fn apply_gem_pickup(player: Player, exp_gain: Int) -> Player
    requires {
        player.pos.x >= -1000000.0,
        player.pos.x <= 1000000.0,
        player.pos.y >= -1000000.0,
        player.pos.y <= 1000000.0,
        player.hp >= 0,
        player.hp <= player.max_hp,
        player.max_hp >= 0,
        player.max_hp <= 1000000000,
        player.exp >= 0,
        player.exp <= 1000000000,
        player.level >= 1,
        player.level <= 10000000,
        player.speed >= 0.0,
        player.speed <= 1000000.0,
        exp_gain >= 0,
        exp_gain <= 1000000000,
    }
    ensures {
        result.pos.x == player.pos.x,
        result.pos.y == player.pos.y,
        result.speed == player.speed,
        result.exp == player.exp + exp_gain,
        result.level >= player.level,
        result.hp >= 0,
        result.hp <= result.max_hp,
    }
{
    let total_exp = player.exp + exp_gain;
    let upgraded = can_level_up(total_exp, player.level);
    match upgraded {
        true => {
            let next_level = player.level + 1;
            let next_max_hp = player.max_hp + 20;
            Player {
                pos: player.pos,
                hp: next_max_hp,
                max_hp: next_max_hp,
                exp: total_exp,
                level: next_level,
                speed: player.speed,
            }
        },
        false => {
            Player {
                pos: player.pos,
                hp: player.hp,
                max_hp: player.max_hp,
                exp: total_exp,
                level: player.level,
                speed: player.speed,
            }
        },
    }
}

fn is_game_over(player: Player) -> Bool
    requires {
        player.hp >= -1000000000,
        player.hp <= 1000000000,
    }
    ensures {
        result == (player.hp <= 0),
    }
{
    player.hp <= 0
}
