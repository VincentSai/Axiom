package axiom:roguelike;

interface types {
    record point {
        x: s64,
        y: s64,
    }

    record stats {
        hp: s64,
        max-hp: s64,
        attack: s64,
        defense: s64,
    }

    record item {
        id: s64,
        name: string,
        value: s64,
    }

    record player {
        id: s64,
        pos: point,
        stats: stats,
        exp: s64,
        level: s64,
    }

    record monster {
        id: s64,
        pos: point,
        stats: stats,
        is-alive: bool,
    }
}

interface audio-effect {
    use types.{point, stats, item, player, monster};

    play-sound: func(name: string) -> ();
}

interface render-effect {
    use types.{point, stats, item, player, monster};

    draw-tile: func(x: s64, y: s64, tile-id: s64) -> ();
}

interface random-effect {
    use types.{point, stats, item, player, monster};

    roll-dice: func(sides: s64) -> s64;
}

world roguelike {
    export types;
    import audio-effect;
    import render-effect;
    import random-effect;

    use types.{point, stats, item, player, monster};

    export try-move: func(pos: point, dx: s64, dy: s64, map-width: s64, map-height: s64) -> point;
    export calculate-damage: func(attacker-atk: s64, defender-def: s64) -> s64;
    export apply-damage: func(current-hp: s64, damage: s64) -> s64;
    export level-up: func(player: player, exp-gained: s64) -> player;
}
