// Axiom Roguelike Benchmark Engine
type Point = {
    x: Int,
    y: Int,
}

type Stats = {
    hp: Int,
    max_hp: Int,
    attack: Int,
    defense: Int,
}

type Item = {
    id: Int,
    name: String,
    value: Int,
}

type Player = {
    id: Int,
    pos: Point,
    stats: Stats,
    exp: Int,
    level: Int,
}

type Monster = {
    id: Int,
    pos: Point,
    stats: Stats,
    is_alive: Bool,
}

// 显式副作用隔离
effect AudioEffect {
    fn play_sound(name: String) -> ();
}

effect RenderEffect {
    fn draw_tile(x: Int, y: Int, tile_id: Int) -> ();
}

effect RandomEffect {
    fn roll_dice(sides: Int) -> Int;
}

// 1. 移动与边界计算 (纯函数 + 形式化契约)
fn try_move(pos: Point, dx: Int, dy: Int, map_width: Int, map_height: Int) -> Point
    requires {
        map_width > 0,
        map_height > 0,
    }
    ensures {
        result.x >= 0 && result.x < map_width &&
        result.y >= 0 && result.y < map_height
    }
{
    let new_x = pos.x + dx;
    let new_y = pos.y + dy;
    if new_x >= 0 && new_x < map_width && new_y >= 0 && new_y < map_height {
        Point { x: new_x, y: new_y }
    } else {
        Point {
            x: if pos.x >= 0 && pos.x < map_width { pos.x } else { 0 },
            y: if pos.y >= 0 && pos.y < map_height { pos.y } else { 0 },
        }
    }
}

// 2. 伤害减免计算
fn calculate_damage(attacker_atk: Int, defender_def: Int) -> Int
    requires {
        attacker_atk >= 0,
        defender_def >= 0,
    }
    ensures {
        result >= 1
    }
{
    let raw = attacker_atk - defender_def;
    if raw > 1 {
        raw
    } else {
        1
    }
}

// 3. 生命值扣减与下溢保护
fn apply_damage(current_hp: Int, damage: Int) -> Int
    requires {
        current_hp >= 0,
        damage >= 0,
    }
    ensures {
        result >= 0 && result <= current_hp
    }
{
    let remaining = current_hp - damage;
    if remaining > 0 {
        remaining
    } else {
        0
    }
}

// 4. 升级与状态提升
fn level_up(player: Player, exp_gained: Int) -> Player
    requires {
        exp_gained >= 0,
        player.level >= 1,
        player.stats.max_hp > 0,
    }
    ensures {
        result.level >= player.level &&
        result.stats.max_hp >= player.stats.max_hp
    }
{
    let new_exp = player.exp + exp_gained;
    let threshold = player.level * 100;
    if new_exp >= threshold {
        Player {
            id: player.id,
            pos: player.pos,
            stats: Stats {
                hp: player.stats.max_hp + 10,
                max_hp: player.stats.max_hp + 10,
                attack: player.stats.attack + 2,
                defense: player.stats.defense + 1,
            },
            exp: new_exp - threshold,
            level: player.level + 1,
        }
    } else {
        Player {
            id: player.id,
            pos: player.pos,
            stats: player.stats,
            exp: new_exp,
            level: player.level,
        }
    }
}
