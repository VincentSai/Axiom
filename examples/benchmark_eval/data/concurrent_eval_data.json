      "assembled_source": "fn can_stack_items(item_id1: Int, count1: Int, max_stack1: Int, item_id2: Int, count2: Int) -> Bool\n    requires {\n        count1 >= 0,\n        count2 >= 0,\n        max_stack1 > 0,\n    }\n    ensures {\n        result == (item_id1 == item_id2 && count1 < max_stack1),\n    }\n{\n    item_id1 == item_id2 && count1 < max_stack1\n}\n\nfn calc_stacked_counts(count1: Int, count2: Int, max_stack: Int) -> Int\n    requires {\n        count1 >= 0,\n        count2 >= 0,\n        max_stack > 0,\n    }\n    ensures {\n        result >= 0,\n        result <= max_stack,\n        count1 + count2 > max_stack => result == max_stack,\n        count1 + count2 <= max_stack => result == count1 + count2,\n    }\n{\n    match count1 + count2 > max_stack { true => max_stack, false => count1 + count2 }\n}\n\nfn calculate_purchase_cost(unit_price: Int, quantity: Int, discount_pct: Int) -> Int\n    requires {\n        unit_price >= 0,\n        quantity >= 0,\n        discount_pct >= 0,\n        discount_pct <= 100,\n    }\n    ensures {\n        result >= 0,\n        result <= unit_price * quantity,\n        discount_pct == 0 => result == unit_price * quantity,\n        discount_pct == 100 => result == 0,\n    }\n{\n    unit_price * quantity * (100 - discount_pct) / 100\n}\n\nfn validate_trade_balance(buyer_gold: Int, total_cost: Int, free_slots: Int, needed_slots: Int) -> Bool\n    requires {\n        buyer_gold >= 0,\n        total_cost >= 0,\n        free_slots >= 0,\n        needed_slots >= 0,\n    }\n    ensures {\n        result == (buyer_gold >= total_cost && free_slots >= needed_slots),\n    }\n{\n    buyer_gold >= total_cost && free_slots >= needed_slots\n}\n\nfn calc_sell_refund(cost: Int, durability_cur: Int, durability_max: Int) -> Int\n    requires {\n        cost >= 0,\n        durability_max > 0,\n        durability_cur >= 0,\n        durability_cur <= durability_max,\n    }\n    ensures {\n        result >= 0,\n        result <= cost,\n        durability_cur == durability_max => result == cost,\n        durability_cur == 0 => result == 0,\n    }\n{\n    cost * durability_cur / durability_max\n}",
